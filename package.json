{
  "name": "sf-onprem-integration-agent",
  "version": "0.2.53",
  "private": true,
  "description": "Salesforce controlled on-prem integration agent",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:agent": "node dist/agent-main.js",
    "start:web": "node dist/web-main.js",
    "start:updater": "node dist/updater-main.js",
    "dev": "ts-node src/main.ts",
    "dev:agent": "ts-node src/agent-main.ts",
    "dev:web": "ts-node src/web-main.ts",
    "dev:updater": "ts-node src/updater-main.ts",
    "spec:new": "node scripts/specs/new-spec.js",
    "spec:validate": "node scripts/specs/validate-specs.js",
    "docker:test:ubuntu": "docker build -f Dockerfile.ubuntu-test -t sf-agent-ubuntu-test . && docker run --rm sf-agent-ubuntu-test",
    "docker:test:separated-hosts": "docker compose -f docker-compose.separated-hosts.yml up --build",
    "linux:install": "bash scripts/linux/install-linux-agent.sh",
    "linux:setup-sftp": "bash scripts/linux/setup-sftp-user.sh",
    "win:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-windows-agent.ps1",
    "win:install-package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-customer-package.ps1",
    "win:install-service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-agent-service.ps1",
    "win:repair-service-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/repair-agent-service-env.ps1",
    "win:uninstall-service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/uninstall-agent-service.ps1",
    "win:update-now": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/update-agent.ps1",
    "win:update-existing": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/update-existing-installation.ps1",
    "win:register-updater": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/register-agent-updater-task.ps1",
    "win:build-package": "node scripts/windows/build-customer-package.js",
    "win:build-package:with-node-modules": "node scripts/windows/build-customer-package.js --include-node-modules",
    "init:installation": "node scripts/salesforce/init-installation.js",
    "sf:seed-dev-sandbox-scenarios": "node scripts/salesforce/seed-dev-sandbox-scenarios.js",
    "projects:migrate-to-sqlite": "node scripts/migrate-projects-to-sqlite.js",
    "sf:deploy-metadata": "ts-node scripts/salesforce/deploy-metadata.ts",
    "sf:debug-oauth": "node scripts/salesforce/debug-oauth.js"
  },
  "dependencies": {
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.5",
    "footable": "^2.0.6",
    "jquery": "^3.7.1",
    "jsforce": "^3.10.14",
    "mssql": "^12.2.0",
    "pino": "^9.4.0",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.9",
    "@types/node": "^22.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
