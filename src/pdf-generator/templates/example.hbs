<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>{{title}}</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 24px; }
      h1 { color: #333; }
      ul { padding-left: 20px; }
    </style>
  </head>
  <body>
    <h1>{{title}}</h1>
    <p>Erstellt am {{createdAt}}</p>

    {{#if items}}
      <ul>
        {{#each items}}
          <li>{{this.name}} — {{this.value}}</li>
        {{/each}}
      </ul>
    {{else}}
      <p><em>Keine Einträge</em></p>
    {{/if}}
  </body>
</html>
