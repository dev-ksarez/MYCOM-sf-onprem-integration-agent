{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PDF Connector Configuration",
  "type": "object",
  "required": ["type", "name", "driver", "options"],
  "properties": {
    "type": { "const": "pdf" },
    "name": { "type": "string" },
    "driver": { "type": "string", "enum": ["file", "s3", "salesforce"] },
    "options": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "basePath": { "type": "string" },
            "pathTemplate": { "type": "string" },
            "permissions": { "type": "string" },
            "maxSizeMb": { "type": "number" }
          },
          "required": ["basePath", "pathTemplate"]
        },
        {
          "properties": {
            "bucket": { "type": "string" },
            "keyTemplate": { "type": "string" },
            "region": { "type": "string" },
            "storageClass": { "type": "string" }
          },
          "required": ["bucket", "keyTemplate"]
        },
        {
          "properties": {
            "targetObject": { "type": "string" },
            "linkMethod": { "type": "string", "enum": ["Attachment","ContentVersion","CustomField"] },
            "fieldMappings": { "type": "object" },
            "contentField": { "type": "string" },
            "contentType": { "type": "string" }
          },
          "required": ["targetObject", "linkMethod"]
        }
      ]
    },
    "retention": {
      "type": "object",
      "properties": { "days": { "type": "integer" } }
    },
    "metadata": { "type": "object" }
  }
}
