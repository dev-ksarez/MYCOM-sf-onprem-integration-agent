NODE_ENV=development
LOG_LEVEL=info
TARGET_SYSTEM=mock
AGENT_ID=local-agent-01

# Optional: Salesforce OIDC login for web admin UI
ADMIN_AUTH_MODE=local
ADMIN_UI_USERS_FILE=artifacts/admin-users.json
SF_IDP_LOGIN_URL=https://test.salesforce.com
SF_IDP_CLIENT_ID=
SF_IDP_CLIENT_SECRET=
SF_IDP_SCOPES=openid
SF_IDP_REDIRECT_URI=http://localhost:18080/auth/salesforce/callback
# Optional alternative to ADMIN_UI_USERS_FILE. Do not commit real passwords.
ADMIN_UI_USERS_JSON=

# Required when using docker-compose.separated-hosts.yml.
AGENT_API_TOKEN=
AGENT_REMOTE_TOKEN=

# Optional: installation mode SAGE100 defaults
SAGE100_ACCOUNT_EXTERNAL_ID_FIELD=AccountNumber
SAGE100_CONTACT_EXTERNAL_ID_FIELD=Email
SAGE100_SQL_SERVER=
SAGE100_SQL_PORT=1433
SAGE100_SQL_DATABASE=
SAGE100_SQL_USER=
SAGE100_SQL_PASSWORD=

# Optional: legacy / existing MSSQL connector secret keys
MSSQL_DEV_PASSWORD=

# Geraeteakte: Basispfad zum Dateiverzeichnis (Standard: Unterordner = Seriennummer)
# Windows-Beispiel: \\\\server\\Geraeteakten
# Annaburg-Beispiel: H:\\130_Produktion\\Fertigung\\Geraeteakte
# Linux-Beispiel:   /mnt/shares/geraeteakten
FILE_BROWSE_BASE_PATH=
# Optional: "annaburg-fg-bucket" fuer Pfade wie Fg0000xx/Fg000073.
GERAETEAKTE_DIRECTORY_LAYOUT=direct

# Geraeteakte Weg 2: Datei-Index periodisch nach Salesforce pushen
# (Agent muss dann NICHT aus dem Internet erreichbar sein)
FILE_INDEX_PUSH_ENABLED=0
FILE_INDEX_PUSH_INTERVAL_MS=300000

# HMAC-Secret fuer signierte Download-URLs (muss identisch im SF-Connector
# unter "Secret Key" hinterlegt sein). Langer Zufallswert.
FILE_DOWNLOAD_SIGNING_SECRET=

# Optionaler HTTPS-Listener (noetig fuer Thumbnail-<img> aus Salesforce,
# da Mixed-Content https erfordert). Wird aktiv, wenn Cert + Key gesetzt sind.
AGENT_API_TLS_CERT=
AGENT_API_TLS_KEY=
AGENT_API_HTTPS_PORT=8443
