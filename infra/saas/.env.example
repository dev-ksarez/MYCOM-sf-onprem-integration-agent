SAAS_DOMAIN=saas.example.com
SAAS_PUBLIC_URL=https://saas.example.com

POSTGRES_DB=sf_agent_saas
POSTGRES_USER=sf_agent_saas
POSTGRES_PASSWORD=change-me-long-random-password

SAAS_APP_IMAGE=ghcr.io/dev-ksarez/sf-onprem-integration-agent-saas:latest
SAAS_JWT_SECRET=change-me-64-byte-random-secret
SAAS_AGENT_TOKEN_PEPPER=change-me-agent-token-pepper
SAAS_ENCRYPTION_KEY=change-me-32-byte-base64-key

BACKUP_RETENTION_DAYS=14
BACKUP_TARGET_DIR=/opt/sf-agent-saas/backups
